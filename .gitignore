# Context Kernel runtime — opaque per-portfolio operational dir
.context-kernel/

# Test repos — external corpora cloned for dogfooding, never committed
test-repos/

# Eval run logs — contain corpus-derived content (records/harnesses ARE committed)
evals/runs/*.log

# Scratch / working docs (local-only, never committed)
# H2 spike artifacts — session logs, prompts, notes, review (all local, contain corpus data)
h2-*

# Python (when implementation starts)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env
.env.local
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Cloudflare Workers
node_modules/
worker-configuration.d.ts
.dev.vars

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local state
.claude/

# Local MCP launchers (machine-specific paths/secrets) — use scripts/mcp-server.sh.example
scripts/mcp-*.sh
